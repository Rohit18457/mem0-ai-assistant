# ==========================================
# Groq API Configuration
# Get your free API key at: https://console.groq.com
# ==========================================
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Name (e.g. qwen/qwen3.8-27b or llama-3.3-70b-versatile)
GROQ_MODEL=qwen/qwen3.8-27b

# ==========================================
# Qdrant Vector Store Configuration
# ==========================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=mem0_hf

# ==========================================
# Embedding Model Configuration
# Uses Hugging Face sentence-transformers locally (Free, no API key needed!)
# ==========================================
EMBEDDING_MODEL=multi-qa-MiniLM-L6-cos-v1
EMBEDDING_DIMS=384

# ==========================================
# Neo4j Graph Store Configuration (Optional / Cloud Aura)
# Get a free cloud instance at: https://neo4j.com/cloud/platform/aura-graph-database/
# ==========================================
NEO4J_URI=neo4j+s://your-database-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ==========================================
# User Identification (No spaces allowed)
# ==========================================
DEFAULT_USER_ID=rohit_suryawanshi
